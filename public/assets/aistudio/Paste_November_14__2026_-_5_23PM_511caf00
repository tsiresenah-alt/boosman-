    <!-- SCRIPT JAVASCRIPT AVEC SUPABASE -->
    <script>
        // CONFIGURATION SUPABASE (Remplacez par vos clés Supabase)
        const SUPABASE_URL = 'VOTRE_SUPABASE_URL';
        const SUPABASE_ANON_KEY = 'VOTRE_SUPABASE_ANON_KEY';
        const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        let currentUser = JSON.parse(localStorage.getItem('bossman_current_user')) || null;
        let subMaintenance = JSON.parse(localStorage.getItem('bossman_sub_maintenance')) || {1: false, 2: false, 3: false, 4: false, 5: false};
        let sectionMaintenance = JSON.parse(localStorage.getItem('bossman_section_maintenance')) || { deposit: false, withdraw: false, referral: false, history: false, support: false };

        let currentLang = localStorage.getItem('bossman_lang') || 'fr';
        let tempResetPhone = '';
        let generatedSmsCode = '';

        const urlParams = new URLSearchParams(window.location.search);
        const refFromUrl = urlParams.get('ref');
        if(refFromUrl) {
            localStorage.setItem('bossman_pending_ref', refFromUrl);
        }

        const subscriptionsData = [
            { id: 1, name: "ABONNEMENT 1 (Débutant)", price: 15000, income: 1000, duration: 31, interval: 2, isVip: false },
            { id: 2, name: "ABONNEMENT 2 (Standard)", price: 25000, income: 1500, duration: 30, interval: 2, isVip: false },
            { id: 3, name: "ABONNEMENT 3 (Pro)", price: 40000, income: 3000, duration: 25, interval: 3, isVip: false },
            { id: 4, name: "ABONNEMENT 4 (VIP BOSS)", price: 75000, income: 5000, duration: 31, interval: 3, isVip: true },
            { id: 5, name: "ABONNEMENT 5 (VIP premium)", price: 90000, income: 6000, duration: 40, interval: 4, isVip: true }
        ];

        const translations = {
            fr: { welcome: "BIENVENUE - Gagnez de l'argent en ligne avec élégance", settingsTitle: "Paramètres & Infos", langLabel: "Choisir la langue / Fidy fiteny :" },
            mg: { welcome: "TONGASOA SOA - Mahazoa vola an-tserasera amin'ny fomba kanto", settingsTitle: "Fikirakirana & Fampahalalana", langLabel: "Fidy fiteny :" }
        };

        function applyLanguage() {
            document.getElementById('language-selector').value = currentLang;
            const t = translations[currentLang];
            if(document.getElementById('txt-welcome')) document.getElementById('txt-welcome').textContent = t.welcome;
            if(document.getElementById('set-title')) document.getElementById('set-title').textContent = t.settingsTitle;
            if(document.getElementById('set-lang-label')) document.getElementById('set-lang-label').textContent = t.langLabel;
        }

        function changeLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('bossman_lang', lang);
            applyLanguage();
            alert(lang === 'mg' ? 'Voafidy soa aman-tsara ny fiteny Malagasy.' : 'Langue française enregistrée avec succès.');
        }

        function playNotificationSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.value = 587.33;
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.5);
            } catch(e) {}
        }

        function updateSectionUI() {
            const sections = [
                { key: 'deposit', id: 'btn-deposit' }, { key: 'withdraw', id: 'btn-withdraw' },
                { key: 'referral', id: 'btn-referral' }, { key: 'history', id: 'btn-history' }, { key: 'support', id: 'btn-support' }
            ];
            sections.forEach(s => {
                const el = document.getElementById(s.id);
                if(!el) return;
                if(sectionMaintenance[s.key]) {
                    el.classList.add('border-red-500', 'bg-red-950/40');
                    if(!el.querySelector('.maint-tag')) {
                        const tag = document.createElement('div');
                        tag.className = 'maint-tag absolute inset-0 bg-red-950/90 flex items-center justify-center p-1 text-[9px] font-black text-white text-center uppercase blinking-banner z-10 rounded-2xl';
                        tag.innerHTML = `<span>MAINTENANCE</span>`;
                        el.appendChild(tag);
                    }
                } else {
                    el.classList.remove('border-red-500', 'bg-red-950/40');
                    const tag = el.querySelector('.maint-tag');
                    if(tag) tag.remove();
                }
            });
        }

        function renderSubscriptionsList() {
            const container = document.getElementById('subscriptions-container');
            if(!container) return;
            container.innerHTML = subscriptionsData.map(sub => {
                const isMaintenance = subMaintenance[sub.id];
                return `
                    <div class="bg-gray-950/60 border ${isMaintenance ? 'border-red-500/80 shadow-red-950/50 shadow-xl' : 'border-gray-800/80'} p-5 rounded-2xl flex flex-col space-y-3 transition-all duration-300 shadow-lg relative overflow-hidden">
                        ${isMaintenance ? `<div class="bg-red-600 text-white text-center py-1.5 px-3 rounded-xl font-black text-[10px] tracking-widest uppercase blinking-banner flex items-center justify-center gap-2"><i class="fa-solid fa-triangle-exclamation"></i> L'ADMIN EST EN TRAIN DE FAIRE UNE MISE À JOUR - MAINTENANCE</div>` : ''}
                        <div class="flex justify-between items-center">
                            <div>
                                <h4 class="font-extrabold ${sub.isVip ? 'text-yellow-400' : 'text-emerald-400'} text-sm">ABONNEMENT ${sub.id}</h4>
                                <p class="text-[11px] text-gray-400 mt-1">Durée : <strong>${sub.duration} jours</strong> | Revenu : <strong class="text-yellow-400">${sub.income.toLocaleString()} Ar</strong></p>
                                <p class="text-xs font-bold mt-2 text-gray-200">Prix : <span class="${sub.isVip ? 'text-yellow-400' : 'text-emerald-400'} font-black">${sub.price.toLocaleString()} Ar</span></p>
                            </div>
                            <button type="button" onclick="subscribe(${sub.id}, ${sub.price}, ${sub.income}, ${sub.duration}, ${sub.interval})" ${isMaintenance ? 'disabled' : ''} class="${isMaintenance ? 'bg-gray-700 text-gray-400 cursor-not-allowed opacity-50' : (sub.isVip ? 'bg-gradient-to-r from-yellow-500 to-amber-600 text-black' : 'bg-gradient-to-r from-emerald-600 to-green-600 text-white')} text-xs font-extrabold px-5 py-2.5 rounded-xl uppercase tracking-wider">Souscrire</button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function refreshAdminBadge() {
            try {
                const { data: requests } = await supabaseClient.from('requests').select('*');
                const { data: messages } = await supabaseClient.from('messages').select('*');
                
                const unviewedReqCount = (requests || []).filter(r => r.viewed === false).length;
                const unreadMsgCount = (messages || []).filter(m => m.sender === 'user' && !m.read).length;
                const totalBadge = unviewedReqCount + unreadMsgCount;

                const badge = document.getElementById('admin-badge-count');
                if(badge) {
                    if(totalBadge > 0) { badge.textContent = totalBadge; badge.classList.remove('hidden'); }
                    else { badge.classList.add('hidden'); }
                }

                if(currentUser && messages) {
                    const userUnreadMsgs = messages.filter(m => m.user_phone === currentUser.phone && m.sender === 'admin' && !m.read).length;
                    const userMsgBadge = document.getElementById('user-msg-badge');
                    if(userMsgBadge) {
                        if(userUnreadMsgs > 0) { userMsgBadge.textContent = userUnreadMsgs; userMsgBadge.classList.remove('hidden'); }
                        else { userMsgBadge.classList.add('hidden'); }
                    }
                }
            } catch(e) {}
        }

        function switchTab(tab) {
            if(tab === 'register') {
                document.getElementById('register-form').classList.remove('hidden');
                document.getElementById('login-form').classList.add('hidden');
                document.getElementById('tab-register-btn').className = 'flex-1 py-2.5 rounded-lg font-bold text-xs uppercase bg-yellow-500 text-black shadow-lg';
                document.getElementById('tab-login-btn').className = 'flex-1 py-2.5 rounded-lg font-bold text-xs uppercase text-gray-400 hover:text-white';
            } else {
                document.getElementById('register-form').classList.add('hidden');
                document.getElementById('login-form').classList.remove('hidden');
                document.getElementById('tab-login-btn').className = 'flex-1 py-2.5 rounded-lg font-bold text-xs uppercase bg-blue-600 text-white shadow-lg';
                document.getElementById('tab-register-btn').className = 'flex-1 py-2.5 rounded-lg font-bold text-xs uppercase text-gray-400 hover:text-white';
            }
        }

        function switchSupportTab(tab) {
            const chatContent = document.getElementById('support-chat-content');
            const depositContent = document.getElementById('support-deposit-content');
            const chatBtn = document.getElementById('sup-tab-chat');
            const depositBtn = document.getElementById('sup-tab-deposit');

            if(tab === 'chat') {
                chatContent.classList.remove('hidden'); depositContent.classList.add('hidden');
                chatBtn.className = 'flex-1 py-2 rounded-lg bg-red-600 text-white transition';
                depositBtn.className = 'flex-1 py-2 rounded-lg text-gray-400 hover:text-white transition';
            } else {
                chatContent.classList.add('hidden'); depositContent.classList.remove('hidden');
                depositBtn.className = 'flex-1 py-2 rounded-lg bg-emerald-600 text-white transition';
                chatBtn.className = 'flex-1 py-2 rounded-lg text-gray-400 hover:text-white transition';
            }
        }

        function validatePassword(input) {
            const feedback = document.getElementById('pass-feedback');
            if(input.value.length < 6) {
                input.className = 'w-full bg-gray-950/80 border border-red-500 rounded-xl px-4 py-3 text-sm text-white focus:outline-none';
                feedback.textContent = 'Le mot de passe doit contenir au moins 6 caractères.';
            } else {
                input.className = 'w-full bg-gray-950/80 border border-yellow-500 rounded-xl px-4 py-3 text-sm text-white focus:outline-none';
                feedback.textContent = 'Mot de passe valide.';
                feedback.className = 'text-[11px] text-emerald-400 mt-1.5 font-medium';
            }
        }

        async function deleteAccount() {
            if(!currentUser) return;
            if(confirm("Voulez-vous vraiment supprimer définitivement votre compte ?")) {
                await supabaseClient.from('users').delete().eq('phone', currentUser.phone);
                await supabaseClient.from('requests').delete().eq('user_phone', currentUser.phone);
                await supabaseClient.from('messages').delete().eq('user_phone', currentUser.phone);

                currentUser = null;
                localStorage.removeItem('bossman_current_user');
                closeModal('settings-modal');
                document.getElementById('dashboard-page').classList.add('hidden');
                document.getElementById('auth-page').classList.remove('hidden');
                alert("Compte supprimé avec succès.");
            }
        }

        async function handleRegister(e) {
            e.preventDefault();
            const name = document.getElementById('reg-name').value;
            const phone = document.getElementById('reg-phone').value;
            const pass = document.getElementById('reg-pass').value;

            if(pass.length < 6) return alert('Mot de passe trop court.');

            const { data: existing } = await supabaseClient.from('users').select('*').eq('phone', phone);
            if(existing && existing.length > 0) return alert('Ce numéro est déjà enregistré.');

            const referralCode = `BOSSMAN-${Math.floor(10 + Math.random() * 90)}`;
            const referredBy = localStorage.getItem('bossman_pending_ref') || null;

            const newUser = {
                name, phone, pass, balance: 2000, referral_code: referralCode, referred_by: referredBy,
                active_sub: null, test_start_time: Date.now(), history: [{type: 'Bonus inscription', amount: 2000, date: new Date().toLocaleString()}]
            };

            await supabaseClient.from('users').insert([newUser]);
            await supabaseClient.from('messages').insert([{
                user_phone: phone, user_name: 'Admin', sender: 'admin',
                text: `Bienvenue sur BOSSMAN Mada, ${name} ! 🎉 Bonus de 2 000 Ar crédité.`,
                date: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}), read: false
            }]);
            await supabaseClient.from('requests').insert([{
                type: 'Nouvelle Inscription', user_name: name, user_phone: phone, amount: 0, status: 'Nouveau Membre', viewed: false
            }]);

            playNotificationSound();
            alert('Inscription réussie ! Vous avez reçu 2 000 Ar de bonus.');
            loginUser(newUser);
        }

        async function handleLogin(e) {
            e.preventDefault();
            const phone = document.getElementById('log-phone').value;
            const pass = document.getElementById('log-pass').value;

            const { data: users } = await supabaseClient.from('users').select('*').eq('phone', phone).eq('pass', pass);
            if(!users || users.length === 0) return alert('Numéro ou mot de passe incorrect.');

            loginUser(users[0]);
        }

        function loginUser(user) {
            document.getElementById('auth-page').classList.add('hidden');
            document.getElementById('loader').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('loader').classList.add('hidden');
                currentUser = user;
                localStorage.setItem('bossman_current_user', JSON.stringify(currentUser));
                updateDashboardUI();
                document.getElementById('dashboard-page').classList.remove('hidden');
            }, 1000);
        }

        function logout() {
            currentUser = null;
            localStorage.removeItem('bossman_current_user');
            document.getElementById('dashboard-page').classList.add('hidden');
            document.getElementById('auth-page').classList.remove('hidden');
        }

        async function updateDashboardUI() {
            if(!currentUser) return;
            const { data: freshUsers } = await supabaseClient.from('users').select('*').eq('phone', currentUser.phone);
            if(freshUsers && freshUsers.length > 0) currentUser = freshUsers[0];

            document.getElementById('dash-username').textContent = currentUser.name;
            document.getElementById('dash-balance').textContent = currentUser.balance + ' Ar';
            document.getElementById('ref-code-display').textContent = currentUser.referral_code;
            document.getElementById('ref-link-input').value = window.location.href.split('?')[0] + '?ref=' + currentUser.referral_code;

            renderSubscriptionsList();
            updateSectionUI();

            const historyList = document.getElementById('history-list');
            const history = currentUser.history || [];
            historyList.innerHTML = history.map(h => `
                <div class="bg-gray-950/80 border border-gray-800/80 p-3 rounded-xl flex justify-between items-center shadow-sm">
                    <div><p class="font-bold text-white">${h.type}</p><p class="text-[10px] text-gray-400">${h.date}</p></div>
                    <span class="font-extrabold text-xs ${h.amount > 0 ? 'text-emerald-400' : 'text-red-400'}">${h.amount > 0 ? '+' : ''}${h.amount} Ar</span>
                </div>
            `).join('') || '<p class="text-gray-500 text-center py-4">Aucun historique</p>';

            refreshAdminBadge();
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            if(id === 'withdraw-modal') calculateWithdrawNet();
            if(id === 'support-chat-modal') {
                loadUserSupportChat();
                markUserMessagesRead();
            }
        }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
        function openSettings() { openModal('settings-modal'); }

        async function markUserMessagesRead() {
            if(!currentUser) return;
            await supabaseClient.from('messages').update({ read: true }).eq('user_phone', currentUser.phone).eq('sender', 'admin');
            refreshAdminBadge();
        }

        function copyReferralLink() {
            navigator.clipboard.writeText(document.getElementById('ref-link-input').value);
            alert('Lien copié !');
        }

        function shareOnWhatsApp() {
            window.open(`https://wa.me/?text=${encodeURIComponent('Rejoins BOSSMAN Mada ! ' + document.getElementById('ref-link-input').value)}`, '_blank');
        }

        function sendAIMessage(e) {
            e.preventDefault();
            const input = document.getElementById('ai-input');
            const msg = input.value.trim();
            if(!msg) return;
            const chatBox = document.getElementById('ai-chat-messages');
            chatBox.innerHTML += `<div class="bg-indigo-600/30 p-3 rounded-2xl max-w-[85%] ml-auto text-white"><strong>Ianao:</strong> ${msg}</div>`;
            input.value = '';
            setTimeout(() => {
                chatBox.innerHTML += `<div class="bg-gray-800 p-3 rounded-2xl max-w-[85%] text-gray-200"><strong>IA:</strong> Salama tsara! Mifandraisa amin'ny admin raha misy fanontaniana.</div>`;
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 1000);
        }

        async function sendSupportMessage(e) {
            e.preventDefault();
            const input = document.getElementById('support-input');
            const text = input.value.trim();
            if(!text || !currentUser) return;

            await supabaseClient.from('messages').insert([{
                user_phone: currentUser.phone, user_name: currentUser.name, sender: 'user',
                text: text, date: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}), read: false
            }]);
            input.value = '';
            loadUserSupportChat();
            refreshAdminBadge();
            playNotificationSound();
        }

        async function loadUserSupportChat() {
            if(!currentUser) return;
            const { data: messages } = await supabaseClient.from('messages').select('*').eq('user_phone', currentUser.phone);
            const chatBox = document.getElementById('support-chat-messages');
            chatBox.innerHTML = (messages && messages.length) ? messages.map(m => `
                <div class="p-3 rounded-2xl max-w-[85%] ${m.sender === 'user' ? 'bg-red-600/30 ml-auto text-white' : 'bg-gray-800 text-gray-200'}">
                    <p class="text-[10px] text-gray-400 mb-1">${m.sender === 'user' ? 'Vous' : 'Admin'} - ${m.date}</p>
                    <p class="text-xs">${m.text}</p>
                </div>
            `).join('') : '<p class="text-gray-500 text-center py-6">Aucun message.</p>';
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        async function submitDeposit(e) {
            e.preventDefault();
            const amount = parseInt(document.getElementById('dep-amount').value);
            const phone = document.getElementById('dep-phone').value;
            const ref = document.getElementById('dep-ref').value;
            const file = document.getElementById('dep-proof').files[0];

            if(amount < 15000) return alert('Minimum dépôt : 15 000 Ar.');
            const reader = new FileReader();
            reader.onload = async function(e) {
                await supabaseClient.from('requests').insert([{
                    type: 'Dépôt', user_phone: currentUser.phone, user_name: currentUser.name,
                    amount, phone, ref, proof_data_url: e.target.result, status: 'En attente', viewed: false
                }]);
                closeModal('deposit-modal');
                alert('Dépôt soumis avec succès.');
                refreshAdminBadge();
            };
            reader.readAsDataURL(file);
        }

        async function submitChatDepositForm(e) {
            e.preventDefault();
            const amount = parseInt(document.getElementById('chat-dep-amount').value);
            const phone = document.getElementById('chat-dep-phone').value;
            const ref = document.getElementById('chat-dep-ref').value;
            const file = document.getElementById('chat-dep-proof').files[0];

            if(amount < 15000) return alert('Minimum dépôt : 15 000 Ar.');
            const reader = new FileReader();
            reader.onload = async function(e) {
                await supabaseClient.from('requests').insert([{
                    type: 'Dépôt', user_phone: currentUser.phone, user_name: currentUser.name,
                    amount, phone, ref, proof_data_url: e.target.result, status: 'En attente', viewed: false
                }]);
                await supabaseClient.from('messages').insert([{
                    user_phone: currentUser.phone, user_name: currentUser.name, sender: 'user',
                    text: `[Dépôt] ${amount} Ar | Réf : ${ref}`, date: new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}), read: false
                }]);
                alert('Dépôt soumis depuis le chat !');
                switchSupportTab('chat');
                loadUserSupportChat();
                refreshAdminBadge();
            };
            reader.readAsDataURL(file);
        }

        function calculateWithdrawNet() {
            const amount = parseInt(document.getElementById('wit-amount').value) || 0;
            const fee = Math.round(amount * 0.10);
            const net = amount > fee ? amount - fee : 0;
            document.getElementById('wit-net-info').innerHTML = `Vous recevrez : <span class="text-emerald-400 font-bold">${net.toLocaleString()} Ar</span> (Frais 10% : ${fee.toLocaleString()} Ar)`;
        }

        async function submitWithdraw(e) {
            e.preventDefault();
            const amount = parseInt(document.getElementById('wit-amount').value);
            const method = document.getElementById('wit-method').value;
            const phone = document.getElementById('wit-phone').value;
            const fee = Math.round(amount * 0.10);

            if(amount < 3000) return alert('Minimum retrait : 3 000 Ar.');
            if(amount > currentUser.balance) return alert('Solde insuffisant.');

            await supabaseClient.from('requests').insert([{
                type: 'Retrait', user_phone: currentUser.phone, user_name: currentUser.name,
                amount, fee, net_amount: amount - fee, method, phone, status: 'En attente', viewed: false
            }]);
            closeModal('withdraw-modal');
            alert('Retrait demandé avec succès !');
            refreshAdminBadge();
        }

        async function subscribe(planId, price, income, durationDays, payoutDaysInterval) {
            if(currentUser.balance < price) return alert('Solde insuffisant.');
            currentUser.balance -= price;
            currentUser.active_sub = { id: planId, name: `ABONNEMENT ${planId}`, income, expiresAt: Date.now() + (durationDays * 86400000), nextPayoutAt: Date.now() + (payoutDaysInterval * 86400000) };
            currentUser.history.push({ type: `Achat Abonnement ${planId}`, amount: -price, date: new Date().toLocaleString() });

            await supabaseClient.from('users').update({ balance: currentUser.balance, active_sub: currentUser.active_sub, history: currentUser.history }).eq('phone', currentUser.phone);
            updateDashboardUI();
            alert('Abonnement activé !');
        }

        async function openAdminLogin() {
            const code = prompt('Mot de passe admin :');
            if(code === 'Hasamlegacy') {
                document.getElementById('auth-page').classList.add('hidden');
                document.getElementById('admin-page').classList.remove('hidden');
                loadAdminData();
            } else if(code !== null) { alert('Mot de passe incorrect.'); }
        }

        function logoutAdmin() {
            document.getElementById('admin-page').classList.add('hidden');
            document.getElementById('auth-page').classList.remove('hidden');
        }

        async function loadAdminData() {
            const { data: users } = await supabaseClient.from('users').select('*');
            const { data: requests } = await supabaseClient.from('requests').select('*');
            const { data: messages } = await supabaseClient.from('messages').select('*');

            await supabaseClient.from('requests').update({ viewed: true }).eq('viewed', false);

            document.getElementById('admin-users-count-badge').textContent = (users || []).length;
            document.getElementById('admin-users-list').innerHTML = (users || []).map(u => `
                <div class="bg-gray-900 p-3 rounded-xl">
                    <p class="font-bold text-white">${u.name} (${u.phone})</p>
                    <p class="text-yellow-400">Solde : ${u.balance} Ar</p>
                </div>
            `).join('');

            document.getElementById('admin-requests-list').innerHTML = (requests || []).map(r => `
                <div class="bg-gray-900 p-3 rounded-xl space-y-2">
                    <p class="font-bold text-white">${r.type} - ${r.user_name} (${r.amount || 0} Ar)</p>
                    ${r.proof_data_url ? `<img src="${r.proof_data_url}" class="max-h-32 rounded">` : ''}
                    <p class="text-xs text-gray-400">Statut : ${r.status}</p>
                    ${r.status === 'En attente' ? `
                        <button onclick="handleRequest(${r.id}, 'Valider')" class="bg-green-600 px-3 py-1 text-white rounded text-xs">Valider</button>
                        <button onclick="handleRequest(${r.id}, 'Refuser')" class="bg-red-600 px-3 py-1 text-white rounded text-xs">Refuser</button>
                    ` : ''}
                </div>
            `).reverse().join('');

            document.getElementById('admin-support-list').innerHTML = (messages || []).map(m => `
                <div class="bg-gray-900 p-3 rounded-xl">
                    <p class="font-bold text-white">${m.user_name} (${m.user_phone})</p>
                    <p class="text-xs text-gray-300">${m.text}</p>
                    <input type="text" id="admin-reply-${m.id}" placeholder="Répondre..." class="bg-gray-950 p-1 text-xs text-white mt-1 w-full">
                    <button onclick="sendAdminReply('${m.user_phone}', ${m.id})" class="bg-blue-600 text-white px-2 py-1 text-xs mt-1 rounded">Envoyer</button>
                </div>
            `).reverse().join('');
        }

        async function sendAdminReply(userPhone, msgId) {
            const text = document.getElementById(`admin-reply-${msgId}`).value.trim();
            if(!text) return;
            await supabaseClient.from('messages').insert([{
                user_phone: userPhone, user_name: 'Admin', sender: 'admin', text, date: new Date().toLocaleTimeString(), read: false
            }]);
            alert('Réponse envoyée !');
            loadAdminData();
        }

        async function handleRequest(id, action) {
            const { data: reqs } = await supabaseClient.from('requests').select('*').eq('id', id);
            if(!reqs || reqs.length === 0) return;
            const req = reqs[0];

            const { data: users } = await supabaseClient.from('users').select('*').eq('phone', req.user_phone);
            if(!users || users.length === 0) return;
            let targetUser = users[0];

            if(action === 'Valider') {
                if(req.type === 'Dépôt') targetUser.balance += req.amount;
                if(req.type === 'Retrait') targetUser.balance -= req.amount;
                await supabaseClient.from('requests').update({ status: 'Validé' }).eq('id', id);
                await supabaseClient.from('users').update({ balance: targetUser.balance }).eq('phone', targetUser.phone);
            } else {
                await supabaseClient.from('requests').update({ status: 'Refusé' }).eq('id', id);
                await supabaseClient.from('messages').insert([{
                    user_phone: req.user_phone, user_name: 'Admin', sender: 'admin', text: `❌ [Demande Refusée] Votre demande a été refusée.`, date: new Date().toLocaleTimeString(), read: false
                }]);
            }
            loadAdminData();
        }

        window.onload = function() {
            applyLanguage();
            refreshAdminBadge();
            renderSubscriptionsList();
            updateSectionUI();
            if(currentUser) {
                document.getElementById('auth-page').classList.add('hidden');
                document.getElementById('dashboard-page').classList.remove('hidden');
                updateDashboardUI();
            }
        };
    </script>
</body>
</html>