<!DOCTYPE html>
<html lang="mg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BOSSMAN Mada</title>
    
    <!-- Balises Open Graph pour l'aperçu Facebook et Messenger -->
    <meta property="og:title" content="BOSSMAN Mada - Gagnez de l'argent en ligne">
    <meta property="og:description" content="Rejoignez BOSSMAN Mada, choisissez votre abonnement et gagnez des revenus en ligne à Madagascar.">
    <meta property="og:image" content="https://tsiresenah-alt.github.io/Boosman2.0/preview_image.png">
    <meta property="og:url" content="https://tsiresenah-alt.github.io/Boosman2.0/">
    <meta property="og:type" content="website">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        @keyframes subtleGlow {
            0% { opacity: 0.8; transform: scale(1); }
            50% { opacity: 1; text-shadow: 0 0 20px rgba(234, 179, 8, 0.7); transform: scale(1.01); }
            100% { opacity: 0.8; transform: scale(1); }
        }
        @keyframes pulseRed {
            0% { transform: scale(1); }
            50% { transform: scale(1.08); }
            100% { transform: scale(1); }
        }
        @keyframes blinkRed {
            0% { opacity: 1; }
            50% { opacity: 0.3; }
            100% { opacity: 1; }
        }
        @keyframes floatAnim {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-4px); }
            100% { transform: translateY(0px); }
        }
        .luxury-title { animation: subtleGlow 3s infinite ease-in-out; }
        .pulse-badge { animation: pulseRed 2s infinite; }
        .blinking-banner { animation: blinkRed 1s infinite; }
        .floating-card { animation: floatAnim 4s infinite ease-in-out; }
        
        .fade-out {
            transition: all 0.8s ease-out;
            opacity: 0;
            transform: scale(0.95);
            max-height: 0;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        body {
            background: linear-gradient(135deg, #090d16 0%, #111827 50%, #030712 100%);
        }
    </style>
</head>
<body class="text-gray-100 font-sans min-h-screen flex flex-col justify-between selection:bg-yellow-500 selection:text-black" onmousemove="refreshAdminBadge()" ontouchstart="refreshAdminBadge()">

    <!-- CONTENEUR PRINCIPAL -->
    <div id="app" class="flex-grow flex flex-col items-center justify-center p-4 sm:p-6">
        
        <!-- PAGE 1: AUTHENTIFICATION -->
        <div id="auth-page" class="w-full max-w-md bg-gray-900/80 backdrop-blur-xl border border-gray-800/80 rounded-3xl p-8 shadow-2xl shadow-black/60 transition-all duration-500">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-black tracking-wider luxury-title bg-gradient-to-r from-yellow-400 via-amber-200 to-yellow-500 bg-clip-text text-transparent mb-2">BOSSMAN Mada</h1>
                <p id="txt-welcome" class="text-gray-400 text-xs font-medium tracking-wide">BIENVENUE - Gagnez de l'argent en ligne avec élégance</p>
            </div>

            <div class="flex bg-gray-950/60 p-1 rounded-xl border border-gray-800/60 mb-6">
                <button type="button" onclick="switchTab('register')" id="tab-register-btn" class="flex-1 py-2.5 rounded-lg font-bold text-xs uppercase tracking-wider transition-all duration-300 bg-yellow-500 text-black shadow-lg">Inscription</button>
                <button type="button" onclick="switchTab('login')" id="tab-login-btn" class="flex-1 py-2.5 rounded-lg font-bold text-xs uppercase tracking-wider transition-all duration-300 text-gray-400 hover:text-white">Connexion</button>
            </div>

            <!-- Inscription -->
            <form id="register-form" onsubmit="handleRegister(event)" class="space-y-4">
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Nom d'utilisateur</label>
                    <input type="text" id="reg-name" required class="w-full bg-gray-950/80 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-yellow-500 transition-colors">
                </div>
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Numéro de téléphone</label>
                    <input type="tel" id="reg-phone" maxlength="10" placeholder="034XXXXXXX" required class="w-full bg-gray-950/80 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-yellow-500 transition-colors">
                </div>
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Mot de passe</label>
                    <input type="password" id="reg-pass" oninput="validatePassword(this)" required class="w-full bg-gray-950/80 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-yellow-500 transition-colors">
                    <p id="pass-feedback" class="text-[11px] text-red-400 mt-1.5 font-medium">Le mot de passe doit contenir au moins 6 caractères.</p>
                </div>
                <div id="ref-notice" class="text-xs text-yellow-400 font-medium hidden bg-yellow-500/10 p-2.5 rounded-xl border border-yellow-500/20"></div>
                <button type="submit" class="w-full bg-gradient-to-r from-yellow-500 via-amber-400 to-yellow-600 hover:from-yellow-400 hover:to-yellow-500 text-black font-extrabold py-3.5 rounded-xl text-xs uppercase tracking-widest shadow-lg shadow-yellow-500/20 transition-all duration-300 transform active:scale-[0.98]">S'inscrire (+2 000 Ar Bonus)</button>
            </form>

            <!-- Connexion -->
            <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4 hidden">
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Numéro de téléphone</label>
                    <input type="tel" id="log-phone" maxlength="10" required class="w-full bg-gray-950/80 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-yellow-500 transition-colors">
                </div>
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Mot de passe</label>
                    <input type="password" id="log-pass" required class="w-full bg-gray-950/80 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-yellow-500 transition-colors">
                </div>
                <div class="text-right">
                    <button type="button" onclick="openModal('forgot-password-modal')" class="text-xs text-yellow-400 hover:underline font-semibold">Mot de passe oublié ?</button>
                </div>
                <button type="submit" class="w-full bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-extrabold py-3.5 rounded-xl text-xs uppercase tracking-widest shadow-lg shadow-blue-600/20 transition-all duration-300 transform active:scale-[0.98]">Se connecter</button>
            </form>

            <div class="mt-8 text-center border-t border-gray-800/60 pt-5">
                <button type="button" onclick="openAdminLogin()" class="relative text-xs text-gray-400 hover:text-yellow-400 font-semibold tracking-wider transition-colors py-1 px-4 rounded-lg bg-gray-950/40 border border-gray-800">
                    Accès Administrateur <span id="admin-badge-count" class="hidden absolute -top-2 -right-2 bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-md pulse-badge">0</span>
                </button>
            </div>
        </div>

        <!-- LOADER -->
        <div id="loader" class="hidden flex flex-col items-center justify-center space-y-4">
            <div class="w-16 h-16 border-4 border-yellow-500 border-t-transparent rounded-full animate-spin shadow-lg shadow-yellow-500/30"></div>
            <p class="text-yellow-400 font-semibold text-sm tracking-wider">Chargement de votre espace...</p>
        </div>

        <!-- PAGE 2: TABLEAU DE BORD -->
        <div id="dashboard-page" class="w-full max-w-2xl bg-gray-900/80 backdrop-blur-xl border border-gray-800/80 rounded-3xl p-6 sm:p-8 shadow-2xl shadow-black/60 hidden transition-all duration-500">
            <div class="flex justify-between items-center mb-6 border-b border-gray-800/80 pb-5">
                <div>
                    <h2 id="dash-username" class="text-2xl font-black text-white tracking-wide">Nom d'utilisateur</h2>
                    <p class="text-xs text-gray-400 mt-0.5">Solde principal : <span id="dash-balance" class="text-yellow-400 font-extrabold text-sm">0 Ar</span></p>
                </div>
                <div class="flex items-center space-x-2.5">
                    <button type="button" onclick="openModal('support-chat-modal')" id="btn-support" class="relative bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 p-3 rounded-2xl text-red-400 transition-all duration-300 transform hover:scale-105" title="Support Admin">
                        <i class="fa-solid fa-headset text-sm"></i>
                        <span id="user-msg-badge" class="hidden absolute -top-1.5 -right-1.5 bg-red-600 text-white text-[9px] font-bold w-5 h-5 flex items-center justify-center rounded-full shadow-md pulse-badge">0</span>
                    </button>
                    <button type="button" onclick="openModal('ai-chat-modal')" class="bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 p-3 rounded-2xl text-indigo-400 transition-all duration-300 transform hover:scale-105" title="Assistant IA">
                        <i class="fa-solid fa-robot text-sm"></i>
                    </button>
                    <button type="button" onclick="openSettings()" class="bg-gray-800/60 hover:bg-gray-800 border border-gray-700/60 p-3 rounded-2xl text-gray-300 transition-all duration-300 transform hover:scale-105" title="Paramètres">
                        <i class="fa-solid fa-gear text-sm"></i>
                    </button>
                    <button type="button" onclick="logout()" class="bg-red-600/10 hover:bg-red-600/20 border border-red-600/30 p-3 rounded-2xl text-red-400 transition-all duration-300 transform hover:scale-105" title="Déconnecter">
                        <i class="fa-solid fa-right-from-bracket text-sm"></i>
                    </button>
                </div>
            </div>

            <!-- Actions Rapides -->
            <div class="grid grid-cols-4 gap-3 mb-6">
                <button type="button" onclick="openModal('deposit-modal')" id="btn-deposit" class="relative bg-gray-950/60 hover:bg-gray-800/80 border border-gray-800 hover:border-emerald-500/50 p-4 rounded-2xl flex flex-col items-center justify-center transition-all duration-300 group overflow-hidden shadow-md">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-wallet text-emerald-400 text-base"></i>
                    </div>
                    <span class="text-xs font-bold text-gray-200">Dépôt</span>
                </button>
                <button type="button" onclick="openModal('withdraw-modal')" id="btn-withdraw" class="relative bg-gray-950/60 hover:bg-gray-800/80 border border-gray-800 hover:border-blue-500/50 p-4 rounded-2xl flex flex-col items-center justify-center transition-all duration-300 group overflow-hidden shadow-md">
                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-money-bill-transfer text-blue-400 text-base"></i>
                    </div>
                    <span class="text-xs font-bold text-gray-200">Retrait</span>
                </button>
                <button type="button" onclick="openModal('referral-modal')" id="btn-referral" class="relative bg-gray-950/60 hover:bg-gray-800/80 border border-gray-800 hover:border-yellow-500/50 p-4 rounded-2xl flex flex-col items-center justify-center transition-all duration-300 group overflow-hidden shadow-md">
                    <div class="w-10 h-10 rounded-xl bg-yellow-500/10 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-users text-yellow-400 text-base"></i>
                    </div>
                    <span class="text-xs font-bold text-gray-200">Parrainage</span>
                </button>
                <button type="button" onclick="openModal('history-modal')" id="btn-history" class="relative bg-gray-950/60 hover:bg-gray-800/80 border border-gray-800 hover:border-purple-500/50 p-4 rounded-2xl flex flex-col items-center justify-center transition-all duration-300 group overflow-hidden shadow-md">
                    <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-clock-rotate-left text-purple-400 text-base"></i>
                    </div>
                    <span class="text-xs font-bold text-gray-200">Histoire</span>
                </button>
            </div>

            <!-- BLOC TEST DU SITE AVEC HORLOGE 24H ET EXPIRATION AUTOMATIQUE -->
            <div id="test-24h-banner" class="bg-gradient-to-r from-gray-950/90 via-gray-900/90 to-amber-950/30 border border-yellow-500/40 p-5 rounded-2xl mb-6 shadow-xl floating-card">
                <div class="flex justify-between items-center mb-2">
                    <h4 class="font-bold text-yellow-400 text-sm flex items-center space-x-2">
                        <i class="fa-solid fa-stopwatch text-base text-yellow-400 animate-pulse"></i> <span>Session Test (Horloge 24h)</span>
                    </h4>
                    <span id="test-clock-display" class="bg-yellow-500/20 border border-yellow-500/40 text-yellow-300 text-xs font-mono font-black px-3 py-1 rounded-full tracking-widest shadow-md">24:00:00</span>
                </div>
                <p class="text-xs text-gray-300 mb-3">Testez le site pendant 24h. Envoyez un commentaire et une capture d'écran d'un bug pour recevoir automatiquement <strong class="text-emerald-400">1 000 Ar</strong> approuvé par l'admin !</p>
                <button type="button" onclick="openModal('bug-report-modal')" class="w-full bg-gradient-to-r from-yellow-500 via-amber-500 to-yellow-600 hover:from-yellow-400 hover:to-yellow-500 text-black font-extrabold py-3 rounded-xl text-xs uppercase tracking-wider transition shadow-lg shadow-yellow-500/20 flex items-center justify-center space-x-2 transform active:scale-95">
                    <i class="fa-solid fa-bug"></i> <span>Signaler un problème (Commentaire + Capture)</span>
                </button>
            </div>

            <!-- BLOC ABONNEMENT ACTIF -->
            <div id="active-sub-banner" class="hidden bg-gradient-to-r from-emerald-950/40 via-gray-900 to-emerald-950/40 border border-emerald-500/30 p-5 rounded-2xl mb-6 flex justify-between items-center shadow-lg shadow-emerald-950/20">
                <div>
                    <h4 id="active-sub-name" class="font-bold text-emerald-400 text-sm flex items-center space-x-2 mb-1">
                        <i class="fa-solid fa-circle-check"></i> <span>ABONNEMENT Actif</span>
                    </h4>
                    <p class="text-xs text-gray-300">Prochain versement dans : <span id="sub-timer" class="font-mono font-bold text-yellow-400 tracking-wider">48:00:00</span></p>
                </div>
                <div class="text-right">
                    <span class="inline-block bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-[10px] font-extrabold uppercase px-3 py-1 rounded-full tracking-wider pulse-badge">Actif en cours</span>
                </div>
            </div>

            <!-- Abonnements -->
            <h3 class="font-extrabold text-sm uppercase tracking-widest text-gray-400 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-gem text-yellow-500"></i> <span>ABONNEMENTS Disponibles</span>
            </h3>
            <div id="subscriptions-container" class="space-y-3.5 mb-2">
                <!-- Rempli dynamiquement en JS -->
            </div>
        </div>

        <!-- ADMIN -->
        <div id="admin-page" class="w-full max-w-6xl bg-gray-900/90 backdrop-blur-xl border border-gray-800 rounded-3xl p-6 sm:p-8 shadow-2xl hidden">
            <div class="flex justify-between items-center mb-6 border-b border-gray-800 pb-5">
                <h2 class="text-xl font-black text-red-500 tracking-wide flex items-center gap-2"><i class="fa-solid fa-shield-halved"></i> <span>Tableau de bord Administrateur</span></h2>
                <button type="button" onclick="logoutAdmin()" class="bg-gray-800 hover:bg-gray-700 text-gray-300 px-4 py-2 rounded-xl text-xs font-bold transition">Quitter Admin</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="space-y-6">
                    <div class="bg-gray-950/60 border border-gray-800 p-5 rounded-2xl shadow-md">
                        <h3 class="font-bold mb-3 text-xs uppercase tracking-wider text-yellow-400">🛠️ Maintenance Sections / Boutons</h3>
                        <div id="admin-section-maintenance-list" class="space-y-2 text-xs"></div>
                    </div>
                    <div class="bg-gray-950/60 border border-gray-800 p-5 rounded-2xl shadow-md">
                        <h3 class="font-bold mb-3 text-xs uppercase tracking-wider text-yellow-400">🛠️ Maintenance ABONNEMENTS</h3>
                        <div id="admin-sub-maintenance-list" class="space-y-2 text-xs"></div>
                    </div>
                    <div class="bg-gray-950/60 border border-gray-800 p-5 rounded-2xl shadow-md">
                        <h3 class="font-bold mb-3 text-xs uppercase tracking-wider text-gray-400 flex justify-between items-center">
                            <span>Utilisateurs & ABONNEMENTS</span>
                            <span id="admin-users-count-badge" class="bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 px-2.5 py-0.5 rounded-full text-[10px] font-black">0</span>
                        </h3>
                        <div id="admin-users-list" class="space-y-3 max-h-60 overflow-y-auto text-xs pr-1"></div>
                    </div>
                </div>
                <div class="bg-gray-950/60 border border-gray-800 p-5 rounded-2xl shadow-md">
                    <h3 class="font-bold mb-3 text-xs uppercase tracking-wider text-gray-400 flex justify-between items-center">
                        <span>Demandes & Rapports de Bugs</span>
                        <span id="admin-requests-count-badge" class="hidden bg-red-600 text-white px-2 py-0.5 rounded-full text-[10px] font-extrabold pulse-badge">0</span>
                    </h3>
                    <div id="admin-requests-list" class="space-y-3 max-h-[500px] overflow-y-auto text-xs pr-1"></div>
                </div>
                <div class="bg-gray-950/60 border border-gray-800 p-5 rounded-2xl shadow-md flex flex-col">
                    <h3 class="font-bold mb-3 text-xs uppercase tracking-wider text-gray-400 flex justify-between items-center">
                        <span>💬 Messages Support</span>
                        <span id="admin-support-count-badge" class="hidden bg-red-600 text-white px-2 py-0.5 rounded-full text-[10px] font-extrabold pulse-badge">0</span>
                    </h3>
                    <div id="admin-support-list" class="flex-grow space-y-3 max-h-[500px] overflow-y-auto text-xs pr-1"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODALE RAPPORT DE BUG (TEST) -->
    <div id="bug-report-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 hidden z-50">
        <div class="bg-gray-900 border border-gray-800 rounded-3xl p-6 w-full max-w-md relative shadow-2xl">
            <button type="button" onclick="closeModal('bug-report-modal')" class="absolute top-5 right-5 text-gray-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="font-black text-lg mb-1 text-yellow-400">Signaler un Problème / Bug</h3>
            <p class="text-gray-400 text-xs mb-4">Envoyez votre commentaire et une capture d'écran pour recevoir 1 000 Ar si approuvé par l'admin.</p>
            
            <form onsubmit="submitBugReport(event)" class="space-y-4">
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Commentaire / Description du problème</label>
                    <textarea id="bug-comment" rows="3" placeholder="Décrivez le bug ou problème rencontré..." required class="w-full bg-gray-950 border border-gray-800 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-yellow-500"></textarea>
                </div>
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Capture d'écran (Image)</label>
                    <input type="file" id="bug-proof" accept="image/*" required class="w-full text-xs text-gray-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-gray-800 file:text-yellow-400 hover:file:bg-gray-700 cursor-pointer">
                </div>
                <button type="submit" class="w-full bg-gradient-to-r from-yellow-500 to-amber-600 hover:from-yellow-400 hover:to-amber-500 text-black font-black py-3.5 rounded-xl text-xs uppercase tracking-widest shadow-lg shadow-yellow-500/20 transition">Envoyer le rapport</button>
            </form>
        </div>
    </div>

    <!-- MODALE MOT DE PASSE OUBLIÉ -->
    <div id="forgot-password-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 hidden z-50">
        <div class="bg-gray-900 border border-gray-800 rounded-3xl p-6 w-full max-w-md relative shadow-2xl">
            <button type="button" onclick="closeModal('forgot-password-modal')" class="absolute top-5 right-5 text-gray-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="font-black text-lg mb-4 text-yellow-400">Récupération du mot de passe</h3>
            
            <div id="forgot-step-1" class="space-y-4">
                <p class="text-xs text-gray-300">Entrez votre numéro de téléphone associé à votre compte pour recevoir un code SMS de confirmation.</p>
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Numéro de téléphone</label>
                    <input type="tel" id="forgot-phone" maxlength="10" placeholder="034XXXXXXX" required class="w-full bg-gray-950 border border-gray-800 rounded-xl p-3.5 text-xs text-white focus:outline-none focus:border-yellow-500">
                </div>
                <button type="button" onclick="sendForgotPasswordCode()" class="w-full bg-gradient-to-r from-yellow-500 to-amber-600 hover:from-yellow-400 hover:to-amber-500 text-black font-black py-3.5 rounded-xl text-xs uppercase tracking-widest shadow-lg shadow-yellow-500/20 transition">Envoyer le code SMS</button>
            </div>

            <div id="forgot-loader" class="hidden flex flex-col items-center justify-center space-y-3 py-6">
                <div class="w-10 h-10 border-3 border-yellow-500 border-t-transparent rounded-full animate-spin"></div>
                <p class="text-yellow-400 font-semibold text-xs tracking-wider">Envoi du code SMS en cours...</p>
            </div>

            <div id="forgot-step-2" class="space-y-4 hidden">
                <p class="text-xs text-emerald-400 font-medium">Un code de confirmation a été envoyé sur votre téléphone.</p>
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Code de confirmation à 4 chiffres</label>
                    <input type="text" id="forgot-code-input" maxlength="4" placeholder="Ex: 1234" required class="w-full bg-gray-950 border border-gray-800 rounded-xl p-3.5 text-sm text-white text-center font-mono tracking-widest focus:outline-none focus:border-yellow-500">
                </div>
                <button type="button" onclick="verifyForgotPasswordCode()" class="w-full bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-white font-black py-3.5 rounded-xl text-xs uppercase tracking-widest shadow-lg shadow-emerald-600/20 transition">Vérifier le code</button>
            </div>

            <div id="forgot-step-3" class="space-y-4 hidden">
                <p class="text-xs text-gray-300">Code vérifié avec succès. Entrez votre nouveau mot de passe.</p>
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-1.5">Nouveau mot de passe (min. 6 caractères)</label>
